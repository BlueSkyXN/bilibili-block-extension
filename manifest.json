{
  "manifest_version": 3,
  "name": "Bilibili 快速拉黑助手",
  "version": "1.0.0",
  "description": "Bilibili 批量拉黑工具，支持单个测试和批量操作，包含 Cookie 管理功能",
  "permissions": [
    "cookies",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://api.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-128.svg",
      "48": "icons/icon-128.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "icons": {
    "16": "icons/icon-128.svg",
    "48": "icons/icon-128.svg",
    "128": "icons/icon-128.svg"
  }
}
